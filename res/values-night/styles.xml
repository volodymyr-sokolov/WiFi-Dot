<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">#FF2ECC40</item>
        <item name="android:colorPrimary">#FF101418</item>
        <item name="android:colorPrimaryDark">#FF101418</item>
        <item name="android:statusBarColor">#FF101418</item>
        <item name="android:navigationBarColor">#FF101418</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
    <style name="MenuTheme" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:backgroundDimAmount">0.35</item>
    </style>
</resources>
